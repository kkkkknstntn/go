  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "seat_unavailable"
          },
          "message": {
            "type": "string"
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "provider"
            ]
          },
          "balance": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "description": "seconds"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresIn": {
            "type": "integer",
            "description": "seconds"
          }
        }
      },
      "Organizer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "balance": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizerId": {
            "type": "string"
          }
        }
      },
      "Seat": {
        "type": "object",
        "properties": {
          "seat": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "reserved",
              "payment_pending",
              "purchased"
            ]
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "seatId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "payment_pending",
              "purchased",
              "canceled",
              "expired",
              "payment_failed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PurchaseStarted": {
        "type": "object",
        "properties": {
          "purchaseId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "payment_pending"
            ]
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "paymentExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "purchaseId": {
            "type": "string"
          },
          "reservationId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "payment_pending",
              "purchased",
              "failed",
              "timed_out"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "purchaseId": {
            "type": "string"
          },
          "reservationId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "organizerId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "timed_out"
            ]
          },
          "failureReason": {
            "type": "string",
            "enum": [
              "insufficient_funds",
              "declined"
            ]
          },
          "purchaseStatus": {
            "type": "string",
            "enum": [
              "payment_pending",
              "purchased",
              "failed",
              "timed_out"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Transition": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": [
              "seat",
              "reservation",
              "purchase",
              "payment"
            ]
          },
          "entityId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
